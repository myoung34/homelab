machine:
  kubelet:
    extraMounts:
      - destination: ${mount_point}
        type: bind
        source: ${mount_point}
        options:
          - bind
          - rshared
          - rw
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: ${mount_point}
provisioning:
  diskSelector:
    match: ${extra_device}
  grow: true
  mountOptions:
    - noatime
---