# N/B: sysctls are now SysctlConfig in Talos v1.14
# This template defines a CPU frequency cap for Raspberry Pi 4 nodes
# to avoid thermal throttling under sustained load.

machine:
  sysfs:
    params:
      devices.system.cpu.cpufreq.policy0.scaling_max_freq: "1500000"
---
apiversion: v1alpha1
kind: SysfsConfig
params:
  devices.system.cpu.cpufreq.policy0.scaling_max_freq: "1500000"
