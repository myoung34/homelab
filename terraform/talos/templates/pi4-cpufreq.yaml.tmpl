# Caps Pi 4s at 1.5GHz at runtime, matching arm_boost=0 in pi.yaml's
# config.txt. Lower clock means lower core voltage and peak draw, which is
# what the PoE HATs brown out on ("Undervoltage detected!", then a throttle
# to 600MHz). Belt and braces: applies without a reboot, and holds even if
# a node still boots an image with arm_boost=1.
apiVersion: v1alpha1
kind: SysfsConfig
params:
  devices.system.cpu.cpufreq.policy0.scaling_max_freq: "1500000"
