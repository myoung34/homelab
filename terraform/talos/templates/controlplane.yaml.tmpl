machine:
  token: ${machine_token}
  logging:
    destinations:
      - endpoint: "tcp://192.168.3.2:5046/"
        format: "json_lines"
  network:
#    hostname: ${hostname}
    #interfaces:
    #    - interface: tailscale0
    #      mtu: 1420
  install:
    image: ${image}
    provision:
      volumeSelector:
        match: name == "EPHEMERAL"
    wipe: true
  features:
    rbac: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: false
  time:
    disabled: false
    servers:
      - time.cloudflare.com
      - time.windows.com
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 10.96.0.10
  - address: 45.90.28.103
  - address: 45.90.30.103
---
apiVersion: v1alpha1
kind: StaticHostConfig
hosts:
  - ip: 192.168.1.254
    aliases:
      - controlplane.cluster.local
---
apiVersion: v1alpha1
kind: SysctlConfig
settings:
  fs.inotify.max_user_instances: "256"
  vm.swappiness: "1"
  net.ipv4.ip_forward: "1"
  net.core.bpf_jit_enable: "1"
  user.max_user_namespaces: "11255"
---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:${kubernetes_version}
defaultRuntimeSeccompProfileEnabled: true
disableManifestsDirectory: true
extraArgs:
  rotate-server-certificates: true
nodeIP:
  validSubnets:
    - 192.168.1.0/24
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeLabels:
  node.longhorn.io/create-default-disk: "true"
---