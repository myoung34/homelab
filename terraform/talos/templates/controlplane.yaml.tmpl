machine:
  network:
    interfaces:
      - deviceSelector:
          hardwareAddr: ${network_hardware_addr}
        dhcp: true
        vip:
          ip: 192.168.1.254
  features:
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
        - os:admin
      allowedKubernetesNamespaces:
        - argocd
cluster:
  network:
    dnsDomain: cluster.local
    podSubnets:
      - 10.244.0.0/16
    serviceSubnets:
      - 10.96.0.0/12
  proxy:
    image: registry.k8s.io/kube-proxy:${kubernetes_version}
  controllerManager:
    image: registry.k8s.io/kube-controller-manager:${kubernetes_version}
  scheduler:
    image: registry.k8s.io/kube-scheduler:${kubernetes_version}
  etcd:
    # Pin peer traffic to the LAN. Without these, Talos picks advertised
    # addresses from whatever node addresses exist when etcd starts, which has
    # selected Tailscale CGNAT addresses (100.64.0.0/10) on some nodes and LAN
    # addresses on others. That makes etcd quorum depend on the tailnet being
    # up, and makes the choice a boot-order race.
    advertisedSubnets:
      - 192.168.1.0/24
    listenSubnets:
      - 192.168.1.0/24
    extraArgs:
      election-timeout: "50000"
      heartbeat-interval: "5000"
  apiServer:
    image: registry.k8s.io/kube-apiserver:${kubernetes_version}
    certSANs:
%{ for san in cert_sans ~}
      - ${san}
%{ endfor ~}
    disablePodSecurityPolicy: true
    admissionControl:
      - configuration:
          apiVersion: pod-security.admission.config.k8s.io/v1alpha1
          defaults:
            audit: restricted
            audit-version: latest
            enforce: baseline
            enforce-version: latest
            warn: restricted
            warn-version: latest
          exemptions:
            namespaces:
              - argocd
              - actions-runner
              - datadog
              - hass
              - esphome
              - reloader
              - local-path-storage
              - node-feature-discovery
              - ser2net
              - zigbee2mqtt
              - tailscale
              - longhorn-system
              - default
              - amdgpu-device-plugin
            runtimeClasses: []
            usernames: []
          kind: PodSecurityConfiguration
        name: PodSecurity
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
  extraManifests:
    # Pinned: these are re-fetched on every node boot, so floating refs (main /
    # latest) let upstream changes land unreviewed and let nodes disagree.
    - https://raw.githubusercontent.com/alex1989hu/kubelet-serving-cert-approver/v0.11.0/deploy/standalone-install.yaml
    - https://github.com/kubernetes-sigs/metrics-server/releases/download/v0.9.0/components.yaml
  inlineManifests: []
