machine:
  token: ${machine_token}
  logging:
    destinations:
      - endpoint: "tcp://192.168.3.2:5046/"
        format: "json_lines"
  network:
#    hostname: ${hostname}
    #interfaces:
    #    - interface: tailscale0
    #      mtu: 1420
  install:
    image: ${image}
    provision:
      volumeSelector:
        match: name == "EPHEMERAL"
    wipe: true
  features:
    rbac: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: false
  time:
    disabled: false
    servers:
      - time.cloudflare.com
      - time.windows.com
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 10.96.0.10
  - address: 45.90.28.103
  - address: 45.90.30.103
---
apiVersion: v1alpha1
kind: StaticHostConfig
hosts:
  - ip: 192.168.1.254
    aliases:
      - controlplane.cluster.local
---
apiVersion: v1alpha1
kind: SysctlConfig
settings:
  fs.inotify.max_user_instances: "256"
  vm.swappiness: "1"
  net.ipv4.ip_forward: "1"
  net.core.bpf_jit_enable: "1"
  user.max_user_namespaces: "11255"
---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:${kubernetes_version}
defaultRuntimeSeccompProfileEnabled: true
disableManifestsDirectory: true
extraArgs:
  rotate-server-certificates: true
nodeIP:
  validSubnets:
    - 192.168.1.0/24
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeLabels:
  node.longhorn.io/create-default-disk: "true"
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
enabled: true
allowedRoles:
  - os:admin
  - os:reader
allowedKubernetesNamespaces:
  - argocd
  - kagent
---
cluster:
  network:
    dnsDomain: cluster.local
    podSubnets:
      - 10.244.0.0/16
    serviceSubnets:
      - 10.96.0.0/12
---
apiVersion: v1alpha1
kind: KubeProxyConfig
image: registry.k8s.io/kube-proxy:${kubernetes_version}
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:${kubernetes_version}
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:${kubernetes_version}
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:${kubernetes_version}
certSANs:
%{ for san in cert_sans ~}
  - ${san}
%{ endfor ~}
disablePodSecurityPolicy: true
---
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
configuration:
  apiVersion: pod-security.admission.config.k8s.io/v1alpha1
  defaults:
    audit: restricted
    audit-version: latest
    enforce: baseline
    enforce-version: latest
    warn: restricted
    warn-version: latest
  exemptions:
    namespaces:
      - argocd
      - actions-runner
      - datadog
      - hass
      - esphome
      - reloader
      - local-path-storage
      - node-feature-discovery
      - ser2net
      - zigbee2mqtt
      - tailscale
      - longhorn-system
      - default
      - amdgpu-device-plugin
    runtimeClasses: []
    usernames: []
  kind: PodSecurityConfiguration
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
apiVersion: audit.k8s.io/v1
kind: Policy
rules:
  - level: Metadata
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
enabled: true
registries:
  kubernetes:
    disabled: true
---
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
manifests:
  - name: kubelet-serving-cert-approver
    url: https://raw.githubusercontent.com/alex1989hu/kubelet-serving-cert-approver/v0.11.0/deploy/standalone-install.yaml
  - name: metrics-server
    url: https://github.com/kubernetes-sigs/metrics-server/releases/download/v0.9.0/components.yaml
---
apiVersion: v1alpha1
kind: KubeInlineManifestConfig
manifests: []
