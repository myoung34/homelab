machine:
  token: ${machine_token}
  logging:
    destinations:
      - endpoint: "tcp://192.168.3.2:5046/"
        format: "json_lines"
#  network:
#    hostname: ${hostname}
    #interfaces:
    #    - interface: tailscale0
    #      mtu: 1420 # https://github.com/tailscale/tailscale/issues/12393#issuecomment-2893170282
  features:
    rbac: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: false
#    stableHostname: true
---
# .machine.kubelet moved here in 1.14. disableManifestsDirectory is gone: the
# document locks it to true, which is what we set anyway.
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:${kubernetes_version}
defaultRuntimeSeccompProfileEnabled: true
extraArgs:
  rotate-server-certificates: "true"
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 192.168.1.0/24
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 10.96.0.10
  - address: 45.90.28.103
  - address: 45.90.30.103
---
apiVersion: v1alpha1
kind: StaticHostConfig
name: 192.168.1.254
hostnames:
  - controlplane.cluster.local
---
# .machine.install.bootloader has no 1.14 equivalent; the bootloader is
# always installed.
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: ${image}
provisioning:
  diskSelector:
    match: disk.dev_path == "${install_disk}"
  wipe: true
#    extraKernelArgs:
#      - talos.logging.kernel=tcp://192.168.3.2:5046/
#      - reboot=k
#      - selinux=0
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  servers:
    - time.cloudflare.com
    - time.windows.com
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_instances: "256"
  vm.swappiness: "1"
  net.ipv4.ip_forward: "1"
  # Talos defaults this to 0, which blocks unprivileged user namespaces
  # outright - the limit is a ucount, so it applies to every user and no
  # capability gets around it. Anything that sandboxes itself by calling
  # unshare(CLONE_NEWUSER) fails: bubblewrap, rootless podman, gVisor,
  # kubevirt's passt binding, nix builds.
  #
  # Raised here for the kagent agents, whose skills run through
  # srt/bubblewrap. Their bwrap is not setuid and the container runs as
  # uid 1001, so a user namespace is its only option - which is also why
  # a privileged container would not have helped.
  # https://docs.siderolabs.com/kubernetes-guides/security/usernamespace
  user.max_user_namespaces: "11255"
---
# Pinned off. Talos 1.14 generates workloadIsolation: true for new configs,
# which moves the container plane into a sandbox namespace and blocks pods
# from the host iscsid that Longhorn's v1 engine attaches volumes through.
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: false
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: ${hostname}
