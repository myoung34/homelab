machine:
  token: ${machine_token}
  logging:
    destinations:
      - endpoint: "tcp://192.168.3.2:5046/"
        format: "json_lines"
---
apiVersion: v1alpha1
kind: KubeletConfig
name: kubelet
image: ghcr.io/siderolabs/kubelet:${kubernetes_version}
defaultRuntimeSeccompProfileEnabled: true
disableManifestsDirectory: true
extraArgs:
  rotate-server-certificates: true
nodeIP:
  validSubnets:
    - 192.168.1.0/24
---
apiVersion: v1alpha1
kind: HostnameConfig
name: hostname
auto: off
hostname: ${hostname}
---
apiVersion: v1alpha1
kind: LinkConfig
name: links
interfaces:
  - interface: tailscale0
    mtu: 1420
---
apiVersion: v1alpha1
kind: ResolverConfig
name: resolver
nameservers:
  - 10.96.0.10
  - 45.90.28.103
  - 45.90.30.103
---
apiVersion: v1alpha1
kind: StaticHostConfig
name: static-hosts
hosts:
  - ip: 192.168.1.254
    aliases:
      - controlplane.cluster.local
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
name: unattended-install
disk: ${install_disk}
image: ${image}
bootloader: true
wipe: true
extraKernelArgs:
  - talos.logging.kernel=tcp://192.168.3.2:5046/
  - reboot=k
  - selinux=0
---
apiVersion: v1alpha1
kind: TimeSyncConfig
name: timesync
disabled: false
servers:
  - time.cloudflare.com
  - time.windows.com
---
apiVersion: v1alpha1
kind: SysctlConfig
name: sysctls
sysctls:
  fs.inotify.max_user_instances: "256"
  vm.swappiness: "1"
  net.ipv4.ip_forward: "1"
  user.max_user_namespaces: "11255"
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
name: kube-talos-api-access
rbac: true
apidCheckExtKeyUsage: true
diskQuotaSupport: false
stableHostname: true
