machine:
  token: ${machine_token}
  logging:
    destinations:
      - endpoint: "tcp://192.168.3.2:5046/"
        format: "json_lines"
  kubelet:
    image: ghcr.io/siderolabs/kubelet:${kubernetes_version}
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraArgs:
      rotate-server-certificates: true
    nodeIP:
      validSubnets:
        - 192.168.1.0/24
  network:
#    hostname: ${hostname}
    #interfaces:
    #    - interface: tailscale0
    #      mtu: 1420 # https://github.com/tailscale/tailscale/issues/12393#issuecomment-2893170282
    nameservers:
      - 10.96.0.10
      - 45.90.28.103
      - 45.90.30.103
    extraHostEntries:
        - ip: 192.168.1.254
          aliases:
            - controlplane.cluster.local
  install:
    disk: ${install_disk}
    image: ${image}
    bootloader: true
    wipe: true
#    extraKernelArgs:
#      - talos.logging.kernel=tcp://192.168.3.2:5046/
#      - reboot=k
#      - selinux=0
  features:
    rbac: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: false
#    stableHostname: true
  time:
    disabled: false
    servers:
      - time.cloudflare.com
      - time.windows.com
  sysctls:
    fs.inotify.max_user_instances: "256"
    vm.swappiness: "1"
    net.ipv4.ip_forward: "1"
    # Talos defaults this to 0, which blocks unprivileged user namespaces
    # outright - the limit is a ucount, so it applies to every user and no
    # capability gets around it. Anything that sandboxes itself by calling
    # unshare(CLONE_NEWUSER) fails: bubblewrap, rootless podman, gVisor,
    # kubevirt's passt binding, nix builds.
    #
    # Raised here for the kagent agents, whose skills run through
    # srt/bubblewrap. Their bwrap is not setuid and the container runs as
    # uid 1001, so a user namespace is its only option - which is also why
    # a privileged container would not have helped.
    # https://docs.siderolabs.com/kubernetes-guides/security/usernamespace
    user.max_user_namespaces: "11255"
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: ${hostname}
