machine:
  token: ${machine_token}
  logging:
    destinations:
      - endpoint: "tcp://192.168.3.2:5046/"
        format: "json_lines"
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
disk: ${install_disk}
image: ${image}
bootloader: true
wipe: true
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: ${hostname}
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - 10.96.0.10
  - 45.90.28.103
  - 45.90.30.103
---
apiVersion: v1alpha1
kind: StaticHostConfig
hosts:
  - ip: 192.168.1.254
    aliases:
      - controlplane.cluster.local
---
apiVersion: v1alpha1
kind: SysctlConfig
settings:
  fs.inotify.max_user_instances: "256"
  vm.swappiness: "1"
  net.ipv4.ip_forward: "1"
  net.core.bpf_jit_enable: "1"
  user.max_user_namespaces: "11255"
---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:${kubernetes_version}
defaultRuntimeSeccompProfileEnabled: true
disableManifestsDirectory: true
extraArgs:
  rotate-server-certificates: true
nodeIP:
  validSubnets:
    - 192.168.1.0/24
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeLabels:
  node.longhorn.io/create-default-disk: "true"
---
