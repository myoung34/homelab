+
+// A skills-init restart (after a failed or stalled clone) finds the earlier
+// attempt's destination on the pod's emptyDir; the clone must replace it,
+// not fail with "already exists" on every restart.
+func TestCloneGitReplacesLeftoverDestination(t *testing.T) {
+	src := t.TempDir()
+	git := func(args ...string) {
+		cmd := exec.Command("git", args...)
+		cmd.Dir = src
+		out, err := cmd.CombinedOutput()
+		if err != nil {
+			t.Fatalf("git %v: %v\n%s", args, err, out)
+		}
+	}
+	git("init", "-q")
+	if err := os.MkdirAll(filepath.Join(src, "skills", "s"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(src, "skills", "s", "SKILL.md"), []byte("x\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	git("add", ".")
+	git("-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "-m", "init")
+	git("tag", "v1")
+
+	dest := filepath.Join(t.TempDir(), "s")
+	if err := os.MkdirAll(filepath.Join(dest, ".git"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dest, "partial"), []byte("x"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := CloneGit(GitRef{URL: "file://" + src, Ref: "v1", Dest: dest, SubPath: "skills/s"}); err != nil {
+		t.Fatalf("CloneGit: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(dest, "SKILL.md")); err != nil {
+		t.Fatalf("SKILL.md missing: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(dest, "partial")); !os.IsNotExist(err) {
+		t.Fatalf("leftover file survived: %v", err)
+	}
+}
