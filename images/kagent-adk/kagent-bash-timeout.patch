@@ -0,0 +1,105 @@
+package skills
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestCommandTimeout(t *testing.T) {
+	tests := []struct {
+		name    string
+		env     string
+		command string
+		want    time.Duration
+	}{
+		{"unset keeps stock default", "", "ls", 30 * time.Second},
+		{"unset keeps stock python default", "", "python3 x.py", 60 * time.Second},
+		{"zero disables", "0", "ls", 0},
+		{"zero disables for python too", "0", "python3 x.py", 0},
+		{"positive overrides both", "120", "python3 x.py", 120 * time.Second},
+		{"invalid keeps stock default", "soon", "ls", 30 * time.Second},
+		{"negative keeps stock default", "-5", "ls", 30 * time.Second},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv(bashTimeoutEnv, tt.env)
+			if got := CommandTimeout(tt.command); got != tt.want {
+				t.Errorf("CommandTimeout(%q) with %s=%q = %v, want %v", tt.command, bashTimeoutEnv, tt.env, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestExecuteCommand_TimeoutFromEnv(t *testing.T) {
+	tmpDir := createTempDir(t)
+	installFakeSRT(t)
+	t.Setenv(bashTimeoutEnv, "1")
+
+	executor, err := NewCommandExecutorFromEnv()
+	if err != nil {
+		t.Fatalf("NewCommandExecutorFromEnv() error = %v", err)
+	}
+	start := time.Now()
+	_, err = executor.ExecuteCommand(context.Background(), "sleep 5", tmpDir)
+	if err == nil || !strings.Contains(err.Error(), "timed out after 1s") {
+		t.Fatalf("want a 1s timeout error, got %v", err)
+	}
+	if elapsed := time.Since(start); elapsed > 4*time.Second {
+		t.Errorf("timeout took %v, want about 1s", elapsed)
+	}
+}
+
+func TestExecuteCommand_ZeroTimeoutRunsToCompletion(t *testing.T) {
+	tmpDir := createTempDir(t)
+	installFakeSRT(t)
+	t.Setenv(bashTimeoutEnv, "0")
+
+	executor, err := NewCommandExecutorFromEnv()
+	if err != nil {
+		t.Fatalf("NewCommandExecutorFromEnv() error = %v", err)
+	}
+	got, err := executor.ExecuteCommand(context.Background(), "sleep 1 && echo done", tmpDir)
+	if err != nil {
+		t.Fatalf("ExecuteCommand() error = %v", err)
+	}
+	if got != "done" {
+		t.Errorf("ExecuteCommand() = %q, want %q", got, "done")
+	}
+}
+
+func TestExecuteCommand_ZeroTimeoutStillHonoursCancel(t *testing.T) {
+	tmpDir := createTempDir(t)
+	installFakeSRT(t)
+	t.Setenv(bashTimeoutEnv, "0")
+
+	executor, err := NewCommandExecutorFromEnv()
+	if err != nil {
+		t.Fatalf("NewCommandExecutorFromEnv() error = %v", err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	start := time.Now()
+	if _, err := executor.ExecuteCommand(ctx, "sleep 10", tmpDir); err == nil {
+		t.Fatal("want an error when the caller cancels, got nil")
+	}
+	if elapsed := time.Since(start); elapsed > 5*time.Second {
+		t.Errorf("cancel took %v, want about 1s", elapsed)
+	}
+}
+
+func TestTimeoutDescription(t *testing.T) {
+	t.Setenv(bashTimeoutEnv, "")
+	if d := TimeoutDescription(); !strings.Contains(d, "python scripts: 60s") || !strings.Contains(d, "other commands: 30s") {
+		t.Errorf("stock description = %q", d)
+	}
+	t.Setenv(bashTimeoutEnv, "0")
+	if d := TimeoutDescription(); !strings.Contains(d, "no timeout") || strings.Contains(d, "30s") {
+		t.Errorf("disabled description = %q", d)
+	}
+	t.Setenv(bashTimeoutEnv, "300")
+	if d := TimeoutDescription(); !strings.Contains(d, "5m0s") {
+		t.Errorf("override description = %q", d)
+	}
+}
