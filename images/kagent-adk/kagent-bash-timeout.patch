diff --git a/go/adk/pkg/skills/timeout.go b/go/adk/pkg/skills/timeout.go
new file mode 100644
index 0000000..53b556c
--- /dev/null
+++ b/go/adk/pkg/skills/timeout.go
@@ -0,0 +1,48 @@
+package skills
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// bashTimeoutEnv overrides the bash tool's per-command timeout, in seconds.
+// Unset, invalid or negative keeps the stock 30s (60s for python); 0 turns
+// the timeout off, leaving only the caller's context to stop a command.
+const bashTimeoutEnv = "KAGENT_BASH_TIMEOUT_SECONDS"
+
+// envTimeout reports the override from bashTimeoutEnv, if one is set.
+func envTimeout() (time.Duration, bool) {
+	n, err := strconv.Atoi(strings.TrimSpace(os.Getenv(bashTimeoutEnv)))
+	if err != nil || n < 0 {
+		return 0, false
+	}
+	return time.Duration(n) * time.Second, true
+}
+
+// CommandTimeout returns how long command may run; 0 means no limit.
+func CommandTimeout(command string) time.Duration {
+	if d, ok := envTimeout(); ok {
+		return d
+	}
+	if strings.Contains(command, "python") {
+		return 60 * time.Second
+	}
+	return 30 * time.Second
+}
+
+// TimeoutDescription is the Timeouts section of the bash tool description,
+// so the model is told the limit it actually runs under.
+func TimeoutDescription() string {
+	d, ok := envTimeout()
+	switch {
+	case !ok:
+		return "Timeouts:\n- python scripts: 60s\n- other commands: 30s"
+	case d == 0:
+		return "Timeouts:\n- no timeout: commands run until they finish, so do not start anything that waits for input or never exits"
+	default:
+		return fmt.Sprintf("Timeouts:\n- every command: %v", d)
+	}
+}
diff --git a/go/adk/pkg/skills/timeout_test.go b/go/adk/pkg/skills/timeout_test.go
