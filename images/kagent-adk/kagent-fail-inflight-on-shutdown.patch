diff --git a/go/adk/pkg/taskstore/shutdown.go b/go/adk/pkg/taskstore/shutdown.go
new file mode 100644
index 0000000..9aaddae
--- /dev/null
+++ b/go/adk/pkg/taskstore/shutdown.go
@@ -0,0 +1,72 @@
+package taskstore
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	a2atype "github.com/a2aproject/a2a-go/a2a"
+	"github.com/a2aproject/a2a-go/a2asrv"
+)
+
+// ShutdownTaskStore wraps a TaskStore and remembers every task whose last
+// saved state was submitted or working. When the pod is stopped mid-turn,
+// FailInFlight marks those tasks failed. Without it they stay "working" in
+// the controller forever, and the UI refuses new messages in that session
+// ("This session is already being processed").
+type ShutdownTaskStore struct {
+	a2asrv.TaskStore
+
+	mu       sync.Mutex
+	closed   bool
+	inFlight map[a2atype.TaskID]a2atype.Task
+}
+
+// NewShutdownTaskStore wraps inner.
+func NewShutdownTaskStore(inner a2asrv.TaskStore) *ShutdownTaskStore {
+	return &ShutdownTaskStore{TaskStore: inner, inFlight: map[a2atype.TaskID]a2atype.Task{}}
+}
+
+// Save implements a2asrv.TaskStore. It fails once FailInFlight has run, so a
+// late event from a still-running execution cannot overwrite the failure.
+func (s *ShutdownTaskStore) Save(ctx context.Context, task *a2atype.Task, event a2atype.Event, prev *a2atype.Task, prevVersion a2atype.TaskVersion) (a2atype.TaskVersion, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return a2atype.TaskVersionMissing, errors.New("agent is shutting down")
+	}
+	v, err := s.TaskStore.Save(ctx, task, event, prev, prevVersion)
+	if err != nil || task == nil {
+		return v, err
+	}
+	switch task.Status.State {
+	case a2atype.TaskStateSubmitted, a2atype.TaskStateWorking:
+		s.inFlight[task.ID] = *task
+	default:
+		delete(s.inFlight, task.ID)
+	}
+	return v, nil
+}
+
+// FailInFlight stops further saves and marks every unfinished task failed
+// with reason as its status message.
+func (s *ShutdownTaskStore) FailInFlight(ctx context.Context, reason string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.closed = true
+	now := time.Now()
+	var errs []error
+	for id, task := range s.inFlight {
+		msg := a2atype.NewMessage(a2atype.MessageRoleAgent, a2atype.TextPart{Text: reason})
+		msg.ContextID = task.ContextID
+		msg.TaskID = id
+		task.Status = a2atype.TaskStatus{State: a2atype.TaskStateFailed, Message: msg, Timestamp: &now}
+		if _, err := s.TaskStore.Save(ctx, &task, nil, nil, a2atype.TaskVersionMissing); err != nil {
+			errs = append(errs, fmt.Errorf("task %s: %w", id, err))
+		}
+		delete(s.inFlight, id)
+	}
+	return errors.Join(errs...)
+}
diff --git a/go/adk/pkg/taskstore/shutdown_test.go b/go/adk/pkg/taskstore/shutdown_test.go
new file mode 100644
index 0000000..239a9a0
--- /dev/null
+++ b/go/adk/pkg/taskstore/shutdown_test.go
@@ -0,0 +1,117 @@
+package taskstore
+
+import (
+	"context"
+	"sync"
+	"testing"
+
+	a2atype "github.com/a2aproject/a2a-go/a2a"
+)
+
+// memStore is a minimal in-memory a2asrv.TaskStore standing in for the
+// controller's task API.
+type memStore struct {
+	mu    sync.Mutex
+	tasks map[a2atype.TaskID]a2atype.Task
+}
+
+func newMemStore() *memStore { return &memStore{tasks: map[a2atype.TaskID]a2atype.Task{}} }
+
+func (m *memStore) Save(_ context.Context, t *a2atype.Task, _ a2atype.Event, _ *a2atype.Task, _ a2atype.TaskVersion) (a2atype.TaskVersion, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.tasks[t.ID] = *t
+	return 1, nil
+}
+
+func (m *memStore) Get(_ context.Context, id a2atype.TaskID) (*a2atype.Task, a2atype.TaskVersion, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	t, ok := m.tasks[id]
+	if !ok {
+		return nil, 0, a2atype.ErrTaskNotFound
+	}
+	return &t, 1, nil
+}
+
+func (m *memStore) List(context.Context, *a2atype.ListTasksRequest) (*a2atype.ListTasksResponse, error) {
+	return nil, nil
+}
+
+func (m *memStore) state(id a2atype.TaskID) a2atype.TaskState {
+	t, _, _ := m.Get(context.Background(), id)
+	return t.Status.State
+}
+
+func save(t *testing.T, s *ShutdownTaskStore, id a2atype.TaskID, state a2atype.TaskState) error {
+	t.Helper()
+	_, err := s.Save(context.Background(), &a2atype.Task{ID: id, ContextID: "ctx", Status: a2atype.TaskStatus{State: state}}, nil, nil, 0)
+	return err
+}
+
+func TestFailInFlightMarksUnfinishedTasksFailed(t *testing.T) {
+	inner := newMemStore()
+	s := NewShutdownTaskStore(inner)
+
+	for id, state := range map[a2atype.TaskID]a2atype.TaskState{
+		"running":   a2atype.TaskStateWorking,
+		"queued":    a2atype.TaskStateSubmitted,
+		"done":      a2atype.TaskStateCompleted,
+		"approval":  a2atype.TaskStateInputRequired,
+		"finished1": a2atype.TaskStateWorking,
+	} {
+		if err := save(t, s, id, state); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// A task that was working and then finished must not be touched.
+	if err := save(t, s, "finished1", a2atype.TaskStateCompleted); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := s.FailInFlight(context.Background(), "agent restarted"); err != nil {
+		t.Fatal(err)
+	}
+
+	want := map[a2atype.TaskID]a2atype.TaskState{
+		"running":   a2atype.TaskStateFailed,
+		"queued":    a2atype.TaskStateFailed,
+		"done":      a2atype.TaskStateCompleted,
+		"approval":  a2atype.TaskStateInputRequired,
+		"finished1": a2atype.TaskStateCompleted,
+	}
+	for id, w := range want {
+		if got := inner.state(id); got != w {
+			t.Errorf("task %s: state %q, want %q", id, got, w)
+		}
+	}
+
+	failed, _, _ := inner.Get(context.Background(), "running")
+	if failed.Status.Message == nil || len(failed.Status.Message.Parts) == 0 {
+		t.Fatal("failed task has no status message explaining why")
+	}
+	if tp, ok := failed.Status.Message.Parts[0].(a2atype.TextPart); !ok || tp.Text != "agent restarted" {
+		t.Errorf("status message = %#v, want text %q", failed.Status.Message.Parts[0], "agent restarted")
+	}
+}
+
+func TestSaveAfterFailInFlightIsRejected(t *testing.T) {
+	inner := newMemStore()
+	s := NewShutdownTaskStore(inner)
+	if err := save(t, s, "running", a2atype.TaskStateWorking); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := s.FailInFlight(context.Background(), "agent restarted"); err != nil {
+		t.Fatal(err)
+	}
+
+	// The execution goroutine is still alive during shutdown; a late working
+	// event must not overwrite the failed status.
+	if err := save(t, s, "running", a2atype.TaskStateWorking); err == nil {
+		t.Error("Save after FailInFlight succeeded, want error")
+	}
+	if got := inner.state("running"); got != a2atype.TaskStateFailed {
+		t.Errorf("state %q after late save, want failed", got)
+	}
+}
