@@ -0,0 +1,41 @@
+package server
+
+import (
+	"context"
+	"syscall"
+	"testing"
+	"time"
+
+	a2atype "github.com/a2aproject/a2a-go/a2a"
+	"github.com/go-logr/logr"
+)
+
+func TestSIGTERMRunsOnShutdown(t *testing.T) {
+	called := make(chan struct{})
+	srv, err := NewA2AServer(a2atype.AgentCard{}, substrateExecutor{}, logr.Discard(), ServerConfig{
+		Host:            "127.0.0.1",
+		Port:            "0",
+		ShutdownTimeout: time.Second,
+		OnShutdown:      func(context.Context) { close(called) },
+	})
+	if err != nil {
+		t.Fatalf("NewA2AServer: %v", err)
+	}
+
+	done := make(chan error, 1)
+	go func() { done <- srv.Run() }()
+	// Let Run install its signal handler before signalling.
+	time.Sleep(200 * time.Millisecond)
+	if err := syscall.Kill(syscall.Getpid(), syscall.SIGTERM); err != nil {
+		t.Fatal(err)
+	}
+
+	select {
+	case <-called:
+	case <-time.After(5 * time.Second):
+		t.Fatal("OnShutdown not called after SIGTERM")
+	}
+	if err := <-done; err != nil {
+		t.Errorf("Run: %v", err)
+	}
+}
