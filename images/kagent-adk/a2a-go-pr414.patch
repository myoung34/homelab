+func TestInMemoryQueue_SubscriberTimeoutDoesNotDropReadySubscriber(t *testing.T) {
+	t.Parallel()
+	qm := newTestManager(t, WithQueueBufferSize(1), WithSubscriberTimeout(time.Nanosecond))
+
