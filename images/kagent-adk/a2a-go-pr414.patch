+		if diff := cmp.Diff(want, got); diff != "" {
+			t.Fatalf("reader.Read() at iteration %d wrong result (-want +got) diff = %s", i, diff)
+		}
+		if err := qm.Destroy(t.Context(), tid); err != nil {
+			t.Fatalf("qm.Destroy() at iteration %d error = %v, want nil", i, err)
+		}
+	}
+}
