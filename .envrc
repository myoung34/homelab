export KUBECONFIG=$(pwd)/talos/kubeconfig
export TALOSCONFIG=$(pwd)/talos/talosconfig
export TERM=xterm-256color # https://github.com/siderolabs/talos/issues/8762
export VAULT_ADDR=http://192.168.3.2:8200/
export NOMAD_ADDR=http://192.168.3.2:4646/
# Fastly object storage (terraform state) rejects the AWS SDK's default
# request checksums: PutObject -> 400 InvalidRequest. Needed together with
# skip_s3_checksum in each terraform backend.
export AWS_REQUEST_CHECKSUM_CALCULATION=when_required
export AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
