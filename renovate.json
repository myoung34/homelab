{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Let a minor/patch release soak before automerge so a pulled release never reaches ArgoCD. Digests carry no release timestamp, so a missing one doesn't block",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchManagers": [
        "kustomize"
      ],
      "matchFileNames": [
        "k8s/prod/datadog/**"
      ],
      "separateMinorPatch": true
    },
    {
      "matchManagers": [
        "kustomize"
      ],
      "matchFileNames": [
        "k8s/prod/datadog/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Skip patch-level skill bumps (e.g. ponytail v1.2.3 -> v1.2.4); minors and majors still open a PR for review",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "k8s/prod/kagent/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Renovate ships patch releases several times a day and the image only runs the config validator, so skip patches; minors and majors still bump",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Hold kagent charts at 0.10.6: the agent images come from images/kagent-adk, so a chart bump also needs KAGENT_VERSION, A2A_VERSION and the image tags moved by hand. Remove once kagent ships a2aproject/a2a-go#414 (see images/kagent-adk/Dockerfile)",
      "matchManagers": [
        "kustomize"
      ],
      "matchFileNames": [
        "k8s/prod/kagent/**"
      ],
      "matchDepNames": [
        "kagent",
        "kagent-crds"
      ],
      "enabled": false
    },
    {
      "description": "Our patched Ollama image (images/ollama) only has the tags we build; the customManagers below bump it from ollama/ollama instead",
      "matchPackageNames": [
        "ghcr.io/myoung34/homelab/ollama"
      ],
      "enabled": false
    },
    {
      "description": "mkuf tags are v<release>-<commits>-g<sha> (git describe), which docker versioning reads as an incompatible suffix",
      "matchPackageNames": [
        "mkuf/klipper",
        "mkuf/moonraker"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<build>\\d+)-g[0-9a-f]+)?$"
    },
    {
      "description": "An ollama/ollama bump also bumps the patched qwen image, whose tag only exists once ollama-image builds it. That check isn't required, so Renovate merges itself after all checks pass, not GitHub after the required ones",
      "matchPackageNames": [
        "ollama/ollama"
      ],
      "platformAutomerge": false
    },
    {
      "description": "silo tags are RELEASE.<date>T<time>Z, which docker versioning can't order",
      "matchPackageNames": [
        "pgsty/silo"
      ],
      "versioning": "regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T(?<build>\\d{2})-\\d{2}-\\d{2}Z$"
    },
    {
      "description": "Talos and Kubernetes pins change only after the nodes are upgraded (terraform/talos/AGENTS.md), so they land together in one PR",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ],
      "groupName": "talos"
    }
  ],
  "customManagers": [
    {
      "description": "Ollama version the patched qwen image (images/ollama) is built from",
      "customType": "regex",
      "managerFilePatterns": [
        "/images/ollama/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG OLLAMA_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "ollama/ollama",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Patched qwen image tag; bumped with OLLAMA_VERSION so both land in one PR",
      "customType": "regex",
      "managerFilePatterns": [
        "/k8s/prod/ollama/ollama\\.yaml$/"
      ],
      "matchStrings": [
        "ghcr\\.io/myoung34/homelab/ollama:(?<currentValue>[0-9.]+)-rocm-pr18433-noshift"
      ],
      "depNameTemplate": "ollama/ollama",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Agent skill repos pinned by git tag in spec.skills.gitRefs",
      "customType": "regex",
      "managerFilePatterns": [
        "/k8s/prod/kagent/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "url: https://github\\.com/(?<depName>[^\\s/]+/[^\\s/]+)\\s+ref: (?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "Nomad job images; Renovate has no Nomad manager",
      "customType": "regex",
      "managerFilePatterns": [
        "/^nomad/.+\\.hcl$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\\s\":@]+):(?<currentValue>[^\\s\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Talos version and the pins that follow it (terraform/talos/AGENTS.md, 'Pins that follow talos_version')",
      "customType": "regex",
      "managerFilePatterns": [
        "/^terraform/talos/(locals\\.tf|README\\.md)$/",
        "/^k8s/prod/kagent/homelab-agent\\.yaml$/",
        "/^k8s/prod/workflows/(etcdsnapshot|talos)\\.yaml$/",
        "/^nomad/netbootxyz\\.hcl$/"
      ],
      "matchStrings": [
        "talos_version\\s*=\\s*\"(?<currentValue>v[^\"]+)\"",
        "ghcr\\.io/siderolabs/talosctl:(?<currentValue>v[^\\s\"]+)",
        "siderolabs/talos/releases/download/(?<currentValue>v[^/]+)/",
        "factory\\.talos\\.dev/(?:installer/[0-9a-f]+:|image/[0-9a-f]+/)(?<currentValue>v[0-9][^/\\s]*)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Kubernetes version Talos runs",
      "customType": "regex",
      "managerFilePatterns": [
        "/^terraform/talos/(locals\\.tf|README\\.md)$/"
      ],
      "matchStrings": [
        "kubernetes_version\\s*=\\s*\"(?<currentValue>v[^\"]+)\"",
        "upgrade-k8s .*--to (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/argo/.+\\.yaml$/",
      "/k8s/prod/.+\\.yaml$/"
    ]
  },
  "pre-commit": {
    "enabled": true
  }
}
